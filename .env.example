# Copy this file to .env and fill it in.  (cp .env.example .env)

# ---------- App ----------
# Any long random text. Signs the login cookie and the Approve/Reject email links.
APP_SECRET=change-this-to-a-long-random-string
# Password for the dashboard login
DASHBOARD_PASSWORD=change-me
# Where the app is reachable. Local: http://localhost:8000   Render: https://your-app.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# ---------- Text AI ----------
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Backup: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free,google/gemma-4-31b-it:free

# ---------- Gemini images (browser cookies from 2 extra Google accounts) ----------
# Copy them from FIREFOX (Chrome/Edge cookies stop working on a server within 1-2 hours).
# Use each cookie in one place only (not on your computer and Render at the same time).
# To replace an expired cookie later: put the new values here (or in Render's Environment tab) and restart.
GEMINI_A_1PSID=
GEMINI_A_1PSIDTS=
GEMINI_B_1PSID=
GEMINI_B_1PSIDTS=
# Optional: only if Google blocks the server's address. Format http://user:pass@host:port
GEMINI_PROXY=

# ---------- Email ----------
# apps_script = recommended. Works on your computer AND on Render. Setup: scripts/email_relay.gs (5 minutes).
# smtp        = Gmail + App Password. Only on your computer (Render's free plan blocks it).
# gmail_api   = Gmail API. Also works on Render, but needs a Google Cloud project (scripts/gmail_auth.py).
EMAIL_MODE=apps_script
# For apps_script: the Web app URL (ends with /exec) and the same SECRET you wrote in the script
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
# For smtp / gmail_api: the extra Gmail that SENDS the emails
GMAIL_SENDER=
# For smtp: https://myaccount.google.com/apppasswords (needs 2-Step Verification on that account)
GMAIL_APP_PASSWORD=
# For gmail_api:
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Who receives review emails (comma-separated for more than one)
REVIEW_EMAIL_TO=
# Who receives cookie/failure alerts (empty = same as REVIEW_EMAIL_TO)
ALERT_EMAIL_TO=

# ---------- Supabase (optional on your computer, required on Render) ----------
# Project Settings → API. Use the service_role / secret key (server only, never share it).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=posts

# ---------- Buffer ----------
# https://publish.buffer.com/settings/api
BUFFER_API_KEY=
# Optional: only post to these channel IDs (run scripts/buffer_channels.py to see them). Empty = all Facebook/X/Threads channels.
BUFFER_CHANNEL_IDS=
# shareNow = post immediately on Approve · addToQueue = next free slot in your Buffer schedule
PUBLISH_MODE=shareNow
# true = Approve does everything except actually posting (for testing)
DRY_RUN_PUBLISH=true
